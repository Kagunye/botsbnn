# Copy to .env and fill in. Upload to Vercel: Project → Settings → Environment Variables → Import .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.bnnengineering.co.ke,bnnengineering.co.ke,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.bnnengineering.co.ke,https://bnnengineering.co.ke,https://*.vercel.app
DJANGO_SERVE_MEDIA=True
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Email via Zoho Mail (info@bnnengineering.co.ke). Use an app-specific password if 2FA is on.
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@bnnengineering.co.ke
EMAIL_HOST_PASSWORD=
NOTIFY_EMAIL=info@bnnengineering.co.ke
